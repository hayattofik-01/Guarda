# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# ---- Database ----
# Preferred: Supabase Postgres connection string (Project Settings > Database > URI).
# When set, this overrides DATABASE_URL. TLS (sslmode=require) is applied automatically.
SUPABASE_DB_URL=
# Local fallback (matches docker-compose db service).
DATABASE_URL=postgresql+psycopg://guarda:guarda@db:5432/guarda
REDIS_URL=redis://redis:6379/0

# ---- Scanner tuning (free OSINT recon tools) ----
NUCLEI_TAGS=exposure,exposures,misconfig,config,backup,logs,secret,token
NUCLEI_SEVERITY=low,medium,high,critical
SUBFINDER_MAX_TIME=300
SCAN_TIMEOUT_SECONDS=1800

# ---- Email alerts (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Guarda <onboarding@resend.dev>
SLACK_WEBHOOK_URL=

# ---- WhatsApp alerts (Twilio, optional) ----
# Create a Twilio account, enable the WhatsApp sandbox (or a WhatsApp sender),
# then paste the Account SID + Auth Token here. From defaults to the sandbox number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Optional intel / discovery (not required) ----
CALA_API_KEY=
CALA_MCP_URL=https://api.cala.ai/mcp/
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=
VULNERS_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
