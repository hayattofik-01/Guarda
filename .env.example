# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# ---- Infra (defaults match docker-compose) ----
DATABASE_URL=postgresql+psycopg://perimeter:perimeter@db:5432/perimeter
REDIS_URL=redis://redis:6379/0

# ---- Scanner tuning ----
NMAP_DEFAULT_ARGS=-Pn -T4 --top-ports 1000 -sV
NUCLEI_SEVERITY=low,medium,high,critical
SCAN_TIMEOUT_SECONDS=1800

# ---- Integrations (ALL optional; MVP needs none) ----
# Structured data / intel layer
CALA_API_KEY=
CALA_MCP_URL=https://api.cala.ai/mcp/

# Asset discovery / scraping
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=

# CVE intel
NVD_API_KEY=
VULNERS_API_KEY=

# Alerts
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@perimeter.local
SLACK_WEBHOOK_URL=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
